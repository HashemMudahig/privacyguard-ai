# PrivacyGuard AI configuration example.
# Copy to .env only if your tooling supports loading it. The CLI itself reads
# real environment variables or explicit command-line flags.
#
# The dataset belongs to the read-only sibling repository. Never edit or copy it
# into this project.
PG_DATASET_DIR=../hackerrank-orchestrate-october26/dataset

# Optional directory for generated JSON reports. Must stay inside this project.
PG_REPORTS_DIR=reports

# SmartShop synthetic test environment (optional live PostgreSQL integration).
# The database name MUST start with smartshop_ and SMARTSHOP_TEST_MODE must be 1.
# Use only placeholder credentials; never commit a real .env file.
# SMARTSHOP_TEST_MODE=1
# SMARTSHOP_PG_HOST=localhost
# SMARTSHOP_PG_PORT=5432
# SMARTSHOP_PG_USER=smartshop_app
# SMARTSHOP_PG_PASSWORD=CHANGE_ME
# SMARTSHOP_PG_DATABASE=smartshop_privacyguard_test
