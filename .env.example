# PrivacyGuard AI configuration example.
# Copy to .env only if your tooling supports loading it. The CLI itself reads
# real environment variables or explicit command-line flags.
#
# The dataset belongs to the read-only sibling repository. Never edit or copy it
# into this project.
PG_DATASET_DIR=../hackerrank-orchestrate-october26/dataset

# Optional directory for generated JSON reports. Must stay inside this project.
PG_REPORTS_DIR=reports
