# PrivacyGuard AI configuration example.
# Copy to .env only if your tooling supports loading it. The CLI itself reads
# real environment variables or explicit command-line flags.
#
# The dataset belongs to the read-only sibling repository. Never edit or copy it
# into this project.
PG_DATASET_DIR=../hackerrank-orchestrate-october26/dataset

# Optional directory for generated JSON reports. Must stay inside this project.
PG_REPORTS_DIR=reports

# Platform runtime persistence. The database name is fixed for isolation.
# Supply real credentials only in an ignored .env or process environment.
# PRIVACYGUARD_DATABASE_URL=postgresql+psycopg://privacyguard_platform_runtime:CHANGE_ME@localhost:5432/privacyguard_platform

# Alembic requires a separate least-privilege DDL role.
# PRIVACYGUARD_MIGRATION_DATABASE_URL=postgresql+psycopg://privacyguard_platform_migrator:CHANGE_ME@localhost:5432/privacyguard_platform

# Explicit opt-in integration tests. These tests write UUID-namespaced synthetic
# rows and remove only those rows. Enable only after discovery and approval.
# PRIVACYGUARD_RUN_POSTGRES_TESTS=0
# PRIVACYGUARD_TEST_DATABASE_URL=postgresql+psycopg://privacyguard_platform_runtime:CHANGE_ME@localhost:5432/privacyguard_platform

# SQLite is never a runtime fallback. Set this only for explicit local tooling;
# create_app("sqlite:///:memory:") needs no environment override.
# PRIVACYGUARD_ALLOW_SQLITE=0

# SmartShop synthetic test environment (optional live PostgreSQL integration).
# The database name MUST start with smartshop_ and SMARTSHOP_TEST_MODE must be 1.
# Use only placeholder credentials; never commit a real .env file.
# SMARTSHOP_TEST_MODE=1
# SMARTSHOP_PG_HOST=localhost
# SMARTSHOP_PG_PORT=5432
# SMARTSHOP_PG_USER=smartshop_app
# SMARTSHOP_PG_PASSWORD=CHANGE_ME
# SMARTSHOP_PG_DATABASE=smartshop_privacyguard_test
